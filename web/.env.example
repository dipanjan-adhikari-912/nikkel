# Nikkel Web Viewer — Environment variables

# Chrome Web Store URL (required for the install page). Set when published to the store.
# The install/download page links here; it is the only installation path.
# Example: https://chromewebstore.google.com/detail/nikkel/xxxxxxxxxx
NEXT_PUBLIC_CHROME_WEB_STORE_URL=

# Supabase — must be set in Vercel dashboard
# SUPABASE_URL (server-side)
# SUPABASE_SERVICE_KEY (server-side)

# Client-side Supabase (for native web login). Use the same Supabase project as the extension.
# NEXT_PUBLIC_SUPABASE_URL=https://ptyogubndwyanjaenmzy.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_rIIjNoFOiD5H7qhJMUPO3Q_Sjr9rsdl

# Paddle billing (set these only when pricing launches — free-for-all phase needs none of them)
# Webhook secret for the /api/webhooks/paddle route (from Paddle dashboard → Developer Tools → Webhooks)
# PADDLE_WEBHOOK_SECRET=
# Price IDs for each plan × interval (from Paddle dashboard → Catalog → Prices)
# PADDLE_PRICE_PRO_MONTHLY=
# PADDLE_PRICE_PRO_YEARLY=
# PADDLE_PRICE_TEAM_MONTHLY=
# PADDLE_PRICE_TEAM_YEARLY=
# Gate to enforce paid plans. Leave unset/false for free-for-all; set to "true" at launch.
# NIKKEL_ENFORCE_PLANS=false
